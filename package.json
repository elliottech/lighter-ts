{
  "name": "lighter-ts",
  "version": "1.0.2",
  "description": "Lighter Typescript Client SDK",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('.git')&&require('child_process').execFileSync('git',['config','core.hooksPath','.githooks'])\"",
    "test": "vitest",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --noCheck && tsup && cpx \"src/**/*.json\" dist",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src && biome check .",
    "lint:fix": "oxlint --type-aware --fix src && biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "scan:secrets": "secretlint --no-gitignore \"**/*\"",
    "prepack": "yarn scan:secrets"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elliottech/lighter-ts.git"
  },
  "author": "elliottech",
  "license": "MIT",
  "homepage": "https://github.com/elliottech/lighter-ts#readme",
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "3.2.11",
    "@formatjs/intl-locale": "5.3.10",
    "@formatjs/intl-numberformat": "9.4.0",
    "@formatjs/intl-pluralrules": "6.3.13",
    "msgpackr": "2.0.6",
    "reselect": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tanstack/react-query": "5.102.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "cpx2": "9.0.3",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "i18next": "26.4.1",
    "lodash-es": "4.18.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "secretlint": "13.0.5",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zklighter-perps": "1.0.303",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.100.14",
    "@types/react": ">=19.1.0 <20",
    "date-fns": ">=4.3.0",
    "decimal.js": ">=10.6.0",
    "i18next": ">=26.2.0",
    "lodash-es": ">=4.18.1",
    "react": ">=19.1.0 <20",
    "zklighter-perps": ">=1.0.303",
    "zod": ">=4.4.3",
    "zustand": ">=5.0.13"
  },
  "resolutions": {
    "esbuild": "0.28.2"
  }
}
