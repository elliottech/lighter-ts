{
  "name": "lighter-ts",
  "version": "1.1.0",
  "description": "Lighter Typescript Client SDK",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fallbacks/*": {
      "types": "./dist/fallbacks/*/index.d.ts",
      "default": "./dist/fallbacks/*/index.js"
    }
  },
  "bin": {
    "strategies-server": "dist/strategies-server/launcher.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('.git')&&require('child_process').execFileSync('git',['config','core.hooksPath','.githooks'])\"",
    "test": "vitest",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --noCheck && tsup && cpx \"src/**/*.json\" dist && rm -rf dist/strategies/server && node src/strategies/server/build-strategies-server.mjs dist/strategies-server",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src && biome check .",
    "lint:fix": "oxlint --type-aware --fix src && biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "scan:secrets": "secretlint --no-gitignore \"**/*\"",
    "prepack": "yarn scan:secrets",
    "strategies-wasm": "node src/strategies/server/download-signer-wasm.mjs",
    "strategies-server": "node src/strategies/server/build-strategies-server.mjs .server && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning .server/server.main.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elliottech/lighter-ts.git"
  },
  "author": "elliottech",
  "license": "MIT",
  "homepage": "https://github.com/elliottech/lighter-ts#readme",
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "3.3.1",
    "@formatjs/intl-locale": "5.4.3",
    "@formatjs/intl-numberformat": "10.0.4",
    "@formatjs/intl-pluralrules": "7.0.4",
    "msgpackr": "2.1.4",
    "reselect": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tanstack/react-query": "5.106.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "cpx2": "9.0.3",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "i18next": "27.1.3",
    "lodash-es": "4.18.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "secretlint": "13.0.5",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.22.2",
    "zklighter-perps": "1.0.372",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.100.14",
    "@types/react": ">=19.1.0 <20",
    "date-fns": ">=4.3.0",
    "decimal.js": ">=10.6.0",
    "i18next": ">=27.0.1",
    "lodash-es": ">=4.18.1",
    "react": ">=19.1.0 <20",
    "zklighter-perps": ">=1.0.372",
    "zod": ">=4.4.3",
    "zustand": ">=5.0.13"
  },
  "resolutions": {
    "esbuild": "0.28.2"
  }
}
